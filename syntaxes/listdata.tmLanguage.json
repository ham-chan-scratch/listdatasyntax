{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "listdatasyntax",
	"scopeName": "source.lsd",
	"patterns": [
		{"include": "#comment"},
		{"include": "#assignment"},
		{"include": "#function"},
		{"include": "#object"}
	],
	"repository": {
		"comment": {
			"patterns": [
				{
					"name": "comment.line.double-slash",
					"match": "^//.*$"
				}
			]
		},
		"assignment": {
			"patterns": [
				{
					"match": "^\\s*(#[a-z0-9_\\.]+)(:)\\s*([A-Za-z0-9/\\+\\-\\*\\.]*)$",
					"captures": {
						"1": {
							"name": "variable.other.readwrite"
						},
						"2": {
							"name": "punctuation.separator.key-value"
						},
						"3": {
							"patterns": [
								{"include": "#value"}
							]
						}
					}
				}
			]
		},
		"function": {
			"patterns": [
				{
					"match": "^\\s*(\\![a-z0-9_]+)((\\(([A-Za-z0-9/\\+\\-\\*\\.]*))(,.*)?\\))?{?$",
					"captures": {
						"1": {
							"name": "entity.name.function"
						},
						"4": {
							"patterns": [
								{"include": "#value"}
							]
						},
						"5": {
							"patterns": [
								{"include": "#arguments"}
							]
						}
					}
				}
			]
		},
		"object": {
			"patterns": [
				{
					"match": "^\\s*([a-z0-9_]*)(:)\\s*([A-Za-z0-9/\\+\\-\\*\\.]+)((,)\\s*(.+))?$",
					"captures": {
						"1": {
							"name": "variable.parameter"
						},
						"2":{
							"name": "punctuation.separator.key-value"
						},
						"3": {
							"patterns": [
								{"include": "#value"}
							]
						},
						"5": {
							"name": "punctuation.separator.comma"
						},
						"6": {
							"patterns": [
								{"include": "#object2"}
							]
						}
					}
				}
			]
		},
		"object2": {
			"patterns": [
				{
					"match": "\\b([a-z0-9_]*)(:)\\s*([A-Za-z0-9/\\+\\-\\*\\.]+)((,)\\s*(.+))?$",
					"captures": {
						"1": {
							"name": "variable.parameter"
						},
						"2":{
							"name": "punctuation.separator.key-value"
						},
						"3": {
							"patterns": [
								{"include": "#value"}
							]
						},
						"5": {
							"name": "punctuation.separator.comma"
						},
						"6": {
							"patterns": [
								{"include": "#object2"}
							]
						}
					}
				}
			]
		},
		"arguments": {
			"patterns": [
			{
				"match": "\\b(,)\\s*([A-Za-z0-9/\\+\\-\\*\\.]+)",
					"captures": {
						"1": {
							"name": "punctuation.separator.comma"
						},
						"2": {
							"patterns": [
								{"include": "#value"}
							]
						}
					}
				},
				{
					"include": "$self"
				}
			]
		},
		"value": {
			"patterns": [
				{
					"match": "\\b(/)?([a-z][0-9]+)+(([\\*/])([\\+-]?[0-9\\.]*))?(([\\+-])([0-9\\.]]*))?",
					"captures": {
						"1": {
							"name": "keyword.operator.arithmetic"
						},
						"2": {
							"name": "variable.language"
						},
						"4": {
							"name": "keyword.operator.arithmetic"
						},
						"5": {
							"patterns": [
								{"include": "#value2"}
							]
						},
						"7": {
							"name": "keyword.operator.arithmetic"
						},
						"8": {
							"patterns": [
								{"include": "#value2"}
							]
						}
					}
				},
				{
					"patterns": [
						{"include": "#value2"}
					]
				}
			]
		},
		"value2": {
			"patterns": [
				{
					"name": "string.other",
					"match": "\\b[A-Z]+\\b"
				},
				{
					"name": "constant.numeric",
					"match": "[+-]?[0-9]+(\\.[0-9]+)?\\b"
				}
			]
		}
	}
}